{
  "name": "mc-agent",
  "version": "0.1.0",
  "description": "Self-built protocol bot for Minecraft 26.3 (protocol 777) with MCP interface for LLM agents",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/http/serve.ts",
    "bot": "tsx src/http/serve.ts",
    "setup": "tsx scripts/setup-overlay.ts",
    "postinstall": "python3 scripts/apply_nmp_patch.py third_party/patches/nmp-entityDelta.diff node_modules/minecraft-protocol || true; tsx scripts/setup-overlay.ts || true",
    "stop": "bash scripts/stop-api.sh",
    "smoke": "node scripts/smoke.mjs",
    "build": "tsc"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "minecraft-data": "^3.119.0",
    "minecraft-protocol": "^1.68.0",
    "pngjs": "^7.0.0",
    "prismarine-chunk": "^1.41.0",
    "prismarine-physics": "^1.11.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}